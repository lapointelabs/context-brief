{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lapointelabs/context-brief/main/schemas/task.schema.json",
  "title": "Context Brief task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "status", "outcome", "behavior", "evidence", "context", "scope", "constraints", "protectedPaths", "acceptance", "verification", "unknowns", "delivery"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "ready", "in_progress", "blocked", "complete"] },
    "outcome": { "type": "string", "minLength": 1 },
    "why": { "type": "string" },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "expected"],
      "properties": {
        "current": { "$ref": "#/$defs/stringList" },
        "expected": { "$ref": "#/$defs/stringList" }
      }
    },
    "evidence": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryPoints", "relatedPaths", "contracts"],
      "properties": {
        "entryPoints": { "$ref": "#/$defs/stringList" },
        "relatedPaths": { "$ref": "#/$defs/stringList" },
        "contracts": { "$ref": "#/$defs/stringList" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in", "out"],
      "properties": {
        "in": { "$ref": "#/$defs/stringList" },
        "out": { "$ref": "#/$defs/stringList" }
      }
    },
    "constraints": { "$ref": "#/$defs/stringList" },
    "protectedPaths": { "$ref": "#/$defs/stringList" },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "criterion", "verification"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" },
          "criterion": { "type": "string", "minLength": 1 },
          "verification": { "enum": ["automated", "manual", "observation"] }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "manual"],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "run"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "run": { "type": "string", "minLength": 1 },
              "cwd": { "type": "string" },
              "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
            }
          }
        },
        "manual": { "$ref": "#/$defs/stringList" }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "assumption", "stopWhen"],
        "properties": {
          "question": { "type": "string" },
          "assumption": { "type": "string" },
          "stopWhen": { "type": "string" }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": { "$ref": "#/$defs/stringList" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference"],
      "properties": {
        "type": { "enum": ["manual", "github", "linear", "jira"] },
        "reference": { "type": "string" },
        "importedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "stringList": { "type": "array", "items": { "type": "string" } }
  }
}
